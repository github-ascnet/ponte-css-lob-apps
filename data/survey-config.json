  "sections": [
    {
      "id": "context",
      "title": "Anwendungskontext",
      "icon": "fa-layer-group",
      "description": "Grundlegende Eckdaten zur Zielapplikation und Plattform.",
      "questions": [
        {
          "id": "appName",
          "type": "text",
          "label": "Name der Applikation",
          "placeholder": "z.B. Patientenportal",
          "required": true,
          "helpText": "Geben sie den Namen der zu bewertenden Applikation an.",
          "rowGroup": "appHeader"
        },
        {
          "id": "technicalContact",
          "type": "text",
          "label": "Technischer Ansprechpartner",
          "placeholder": "z.B. Max Mustermann (intern) oder support@vendor.com",
          "required": false,
          "helpText": "Interner oder externer (Hersteller) Ansprechpartner für technische Rückfragen.",
          "rowGroup": "appHeader"
        },
        {
          "id": "operatingModel",
          "type": "dropdown",
          "label": "Betriebsmodell",
          "required": true,
          "optionSet": "betriebsmodell"
        },
        {
          "id": "platform",
          "type": "checkbox-group",
          "label": "Plattform",
          "required": true,
          "optionSet": "plattform"
        }
      ]
    },
    {
      "id": "authentication",
      "title": "Authentifizierung",
      "icon": "fa-user-shield",
      "description": "Bewertung der eingesetzten Authentifizierungsverfahren.",
      "questions": [
        {
          "id": "supportsModernProtocols",
          "type": "radio-cards",
          "label": "Unterstützt die Lösung moderne Verfahren (SAML/OIDC/OAuth)?",
          "required": true,
          "optionSet": "yesNoUnknown"
        },
        {
          "id": "authenticationMethods",
          "type": "checkbox-group",
          "label": "Unterstützte Authentifizierung",
          "required": true,
          "optionSet": "authentifizierung"
        },
        {
          "id": "crossForestCapability",
          "type": "dropdown",
          "label": "Cross-Forest-Fähigkeit",
          "required": true,
          "optionSet": "cross_forest"
        }
      ]
    },
    {
      "id": "identity",
      "title": "Identifikation und Identity Provider",
      "icon": "fa-id-card",
      "description": "Welche Identifikatoren und IdP-Anbindungen bestehen?",
      "questions": [
        {
          "id": "userIdentification",
          "type": "dropdown",
          "label": "Benutzeridentifikation",
          "required": true,
          "optionSet": "benutzeridentifikation"
        },
        {
          "id": "identityProvider",
          "type": "dropdown",
          "label": "Identity Provider",
          "required": true,
          "optionSet": "identity_provider"
        },
        {
          "id": "groupSupport",
          "type": "dropdown",
          "label": "Gruppenunterstützung",
          "required": true,
          "optionSet": "gruppenunterstuetzung"
        }
      ]
    },
    {
      "id": "authorization",
      "title": "Autorisierung und Einschränkungen",
      "icon": "fa-key",
      "description": "Rollenmodell, technische Grenzen und Migrationsauswirkungen.",
      "questions": [
        {
          "id": "authorizationModel",
          "type": "dropdown",
          "label": "Autorisierung",
          "required": true,
          "optionSet": "autorisierung"
        },
        {
          "id": "knownLimitations",
          "type": "checkbox-group",
          "label": "Bekannte Einschränkungen",
          "required": true,
          "optionSet": "einschraenkungen"
        },
        {
          "id": "migrationImpact",
          "type": "dropdown",
          "label": "Migration",
          "required": true,
          "optionSet": "migration"
        }
      ]
    },
    {
      "id": "assessment",
      "title": "Gesamtbewertung",
      "icon": "fa-gauge-high",
      "description": "Strukturierte Bewertung von Risiko, Kompatibilität und Anpassungsbedarf.",
      "questions": [
        {
          "id": "compatibilityAssessment",
          "type": "dropdown",
          "label": "Bewertung",
          "required": true,
          "optionSet": "bewertung"
        },
        {
          "id": "riskScore",
          "type": "rating-scale",
          "label": "Risiko (1-5)",
          "required": true,
          "optionSet": "rating_1_5"
        },
        {
          "id": "adaptationScore",
          "type": "rating-scale",
          "label": "Anpassungsbedarf (1-5)",
          "required": true,
          "optionSet": "rating_1_5"
        },
        {
          "id": "trafficLight",
          "type": "ampel",
          "label": "Ampelbewertung",
          "required": true,
          "optionSet": "ampelbewertung"
